            {
              "id": "nd000012",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"cta\" id=\"cta\">\n  <div>\n    <div class=\"section__eyebrow\">Let&rsquo;s talk</div>\n    <h2 class=\"cta__title\">Start to build your project <span class=\"italic\">with us</span>.</h2>\n    <p class=\"cta__body\">\n      Tell us what you&rsquo;re working on &mdash; a site rebuild, a stalled Odoo project, a growth program that isn&rsquo;t moving. We&rsquo;ll respond within one business day with a plan, not a sales pitch.\n    </p>\n    <div class=\"cta__phones\">\n      <span>&#x260E; Montr&eacute;al-Toronto <b>(450) 990-0134</b></span>\n      <span>&middot; Miami <b>(877) 477-4146</b></span>\n    </div>\n  </div>\n\n  <form class=\"cta__form\" method=\"post\" action=\"\" onsubmit=\"event.preventDefault()\">\n    <div>\n      <label>Work email</label>\n      <input type=\"email\" name=\"email\" placeholder=\"jane@acme.com\" autocomplete=\"email\">\n    </div>\n    <div class=\"cta__form-row\">\n      <div>\n        <label>Company</label>\n        <input type=\"text\" name=\"company\" placeholder=\"Acme Industries\" autocomplete=\"organization\">\n      </div>\n      <div>\n        <label>Budget</label>\n        <select name=\"budget\">\n          <option>$15k &ndash; $50k</option>\n          <option>$50k &ndash; $150k</option>\n          <option>$150k+</option>\n          <option>Ongoing retainer</option>\n        </select>\n      </div>\n    </div>\n    <div>\n      <label>Service of interest</label>\n      <select name=\"service\">\n        <option>Website design &amp; development</option>\n        <option>SEO &amp; paid media</option>\n        <option>Odoo implementation</option>\n        <option>Social media management</option>\n        <option>Consulting / advisory</option>\n      </select>\n    </div>\n    <div class=\"submit-row\">\n      <small>&#x2713; Law 25 compliant &middot; Data stays in Canada</small>\n      <button type=\"submit\" class=\"nd-btn nd-btn--accent\">Request a quote <span class=\"arrow\">&rarr;</span></button>\n    </div>\n  </form>\n</section>"
              },
