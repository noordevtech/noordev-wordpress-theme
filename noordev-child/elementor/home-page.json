              "id": "nd000003",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"hero\" data-screen-label=\"Home Hero\">\n  <div class=\"hero__video\" aria-hidden=\"true\">\n    <iframe id=\"hero-vimeo\"\n      src=\"https://player.vimeo.com/video/1045372807?background=1&amp;autoplay=1&amp;loop=1&amp;muted=1&amp;autopause=0&amp;controls=0&amp;byline=0&amp;title=0&amp;portrait=0\"\n      allow=\"autoplay; fullscreen; picture-in-picture\"\n      loading=\"eager\"\n      title=\"Noordev showreel\"></iframe>\n  </div>\n  <div class=\"hero__veil\" aria-hidden=\"true\"></div>\n\n  <div class=\"hero__inner\">\n    <div class=\"hero__top\">\n      <div class=\"hero__eyebrow\"><b>&bull;</b> Digital agency, Odoo &amp; cybersecurity &middot; est. 2012</div>\n      <span class=\"hero__reel\"><span class=\"live\"></span> Showreel &middot; Volume 14</span>\n    </div>\n\n    <div class=\"hero__body\">\n      <h1>\n        Build your brand,<br>\n        harden your operations,<br>\n        <span class=\"italic\">certify</span> what matters<span class=\"accent-dot\"></span>\n      </h1>\n      <p class=\"hero__lede\">\n        Websites, growth programs, Odoo implementations, ISO 27001 certification, and corporate training &mdash; delivered by one senior team across four cities.\n      </p>\n      <div class=\"hero__cta\">\n        <a class=\"nd-btn nd-btn--accent nd-btn--lg\" href=\"#cta\">Get a quote <span class=\"arrow\">&rarr;</span></a>\n        <a class=\"nd-btn nd-btn--secondary nd-btn--lg\" href=\"#\">See our work</a>\n        <small>TYPICALLY ANSWERED IN ONE BUSINESS DAY</small>\n      </div>\n    </div>\n\n    <button type=\"button\" class=\"hero__sound\" id=\"hero-sound-toggle\" aria-pressed=\"false\" aria-label=\"Toggle showreel sound\">\n      <svg viewBox=\"0 0 24 24\" id=\"hero-sound-icon\" aria-hidden=\"true\"><path d=\"M4 9 H8 L13 4 V20 L8 15 H4 Z\"/><path d=\"M17 8 L21 16 M21 8 L17 16\"/></svg>\n      <span id=\"hero-sound-label\">Sound off</span>\n    </button>\n\n    <div class=\"hero__stats\">\n      <div class=\"hero__stat\"><div class=\"k\">14<span class=\"unit\">yrs</span></div><div class=\"l\">Shipping digital work</div></div>\n      <div class=\"hero__stat\"><div class=\"k\">230+</div><div class=\"l\">Engagements delivered</div></div>\n      <div class=\"hero__stat\"><div class=\"k\">4</div><div class=\"l\">Offices &middot; 3 continents</div></div>\n      <div class=\"hero__stat\"><div class=\"k\">98<span class=\"unit\">%</span></div><div class=\"l\">Clients who renew</div></div>\n    </div>\n  </div>\n\n  <script>\n  (function () {\n    if (window.__noordevHeroSoundLoaded) return; window.__noordevHeroSoundLoaded = true;\n    function init() {\n      var iframe = document.getElementById('hero-vimeo');\n      var btn    = document.getElementById('hero-sound-toggle');\n      var label  = document.getElementById('hero-sound-label');\n      var icon   = document.getElementById('hero-sound-icon');\n      if (!window.Vimeo || !iframe || !btn) return;\n      var player = new window.Vimeo.Player(iframe);\n      var unmuted = false;\n      btn.addEventListener('click', async function () {\n        unmuted = !unmuted;\n        try { await player.setMuted(!unmuted); await player.setVolume(unmuted ? 0.6 : 0); } catch (e) {}\n        btn.setAttribute('aria-pressed', String(unmuted));\n        if (label) label.textContent = unmuted ? 'Sound on' : 'Sound off';\n        if (icon) icon.innerHTML = unmuted\n          ? '<path d=\"M4 9 H8 L13 4 V20 L8 15 H4 Z\"/><path d=\"M16 9 C18 11 18 13 16 15\"/><path d=\"M19 6 C22 9 22 15 19 18\"/>'\n          : '<path d=\"M4 9 H8 L13 4 V20 L8 15 H4 Z\"/><path d=\"M17 8 L21 16 M21 8 L17 16\"/>';\n      });\n    }\n    function ensureVimeo(cb) {\n      if (window.Vimeo) return cb();\n      var s = document.createElement('script');\n      s.src = 'https://player.vimeo.com/api/player.js';\n      s.async = true;\n      s.onload = cb;\n      document.head.appendChild(s);\n    }\n    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { ensureVimeo(init); });\n    else ensureVimeo(init);\n  })();\n  </script>\n</section>"
