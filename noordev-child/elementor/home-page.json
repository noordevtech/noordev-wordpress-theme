          "elements": [
            {
              "id": "nd00000f",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"process\">\n  <div class=\"process__inner\">\n    <div class=\"section__head\" style=\"margin-bottom: 0;\">\n      <div>\n        <div class=\"section__eyebrow\">How we work</div>\n        <h2 class=\"section__title\">A disciplined, senior-led <span class=\"italic\">engagement</span> &mdash; no surprises.</h2>\n      </div>\n      <p class=\"section__body\">\n        Weekly checkpoints, a transparent statement of work, and one point of contact throughout. Your team is always one level away from a decision-maker.\n      </p>\n    </div>\n    <div class=\"process__grid\">\n      <div class=\"step\">\n        <div class=\"step__n\">Step 01 &middot; Week 1</div>\n        <h4 class=\"step__title\">Discovery</h4>\n        <p class=\"step__body\">Stakeholder interviews, an audit of what exists, and a shared definition of what success looks like at the end.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"step__n\">Step 02 &middot; Week 2&ndash;3</div>\n        <h4 class=\"step__title\">Scope &amp; shape</h4>\n        <p class=\"step__body\">A written proposal: scope, timeline, price, and the resources required on both sides. Nothing proceeds without sign-off.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"step__n\">Step 03 &middot; Week 4&ndash;10</div>\n        <h4 class=\"step__title\">Design &amp; build</h4>\n        <p class=\"step__body\">Interactive wireframes, a branded prototype, then production. You review at each stage &mdash; no 12-week reveals.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"step__n\">Step 04 &middot; Launch + ongoing</div>\n        <h4 class=\"step__title\">Measure &amp; improve</h4>\n        <p class=\"step__body\">Monthly analytics review. We ship improvements continuously against the metrics we agreed to in week one.</p>\n      </div>\n    </div>\n  </div>\n</section>"
              },
