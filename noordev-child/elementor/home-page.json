              "id": "nd00000c",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"case\">\n  <div class=\"case__inner\">\n    <div>\n      <div class=\"case__eyebrow\">Case study &middot; Meridian Bank &middot; 2025</div>\n      <p class=\"case__quote\">Attention to detail and creativity truly set them apart. Our site now converts at three times the rate of the old one &mdash; and the board notices.</p>\n      <div class=\"case__by\">\n        <div class=\"case__avatar\">JL</div>\n        <div class=\"case__by-who\"><b>Jane Lafleur</b>Head of Marketing, Meridian Bank</div>\n      </div>\n      <a class=\"nd-btn nd-btn--ghost-light\" href=\"#\">Read the full case study <span class=\"arrow\">&rarr;</span></a>\n    </div>\n    <div class=\"case__metrics\">\n      <div class=\"case__metric\">\n        <div class=\"k\">3.2<span class=\"unit\">&times;</span></div>\n        <div class=\"l\">Conversion rate</div>\n        <div class=\"delta\">&uarr; vs. legacy site</div>\n      </div>\n      <div class=\"case__metric\">\n        <div class=\"k\">0.9<span class=\"unit\">s</span><span class=\"dot\"></span></div>\n        <div class=\"l\">Largest Contentful Paint</div>\n        <div class=\"delta\">&darr; from 3.4s &middot; p75 mobile</div>\n      </div>\n      <div class=\"case__metric\">\n        <div class=\"k\">+187<span class=\"unit\">%</span></div>\n        <div class=\"l\">Organic sessions</div>\n        <div class=\"delta\">&uarr; 12-month window</div>\n      </div>\n      <div class=\"case__metric\">\n        <div class=\"k\">$1.2<span class=\"unit\">M</span></div>\n        <div class=\"l\">Pipeline attributed</div>\n        <div class=\"delta\">&uarr; Q1 2026</div>\n      </div>\n    </div>\n  </div>\n</section>"
