              "id": "nd000012",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"proof\" data-screen-label=\"Security proof\">\n  <div class=\"proof__inner\">\n    <div>\n      <div class=\"section__eyebrow\">Client &middot; Meridian Bank &middot; Toronto</div>\n      <blockquote class=\"proof__quote\">\n        Noordev delivered our ISO 27001 certification in eleven months &mdash; and, more impressively, wrote policies our engineers actually read.\n      </blockquote>\n      <div class=\"proof__by\">\n        <div class=\"proof__avatar\">SR</div>\n        <div class=\"proof__by-who\"><b>Samira Rahimi</b><span>Head of Information Security, Meridian Bank</span></div>\n      </div>\n    </div>\n    <div class=\"proof__stats\">\n      <div class=\"proof__stat\"><div class=\"k\">11<span class=\"unit\">mo</span></div><div class=\"l\">Assessment &rarr; Stage 2 pass</div></div>\n      <div class=\"proof__stat\"><div class=\"k\">0</div><div class=\"l\">Major nonconformities</div></div>\n      <div class=\"proof__stat\"><div class=\"k\">3&times;</div><div class=\"l\">Faster vendor questionnaire turnaround</div></div>\n      <div class=\"proof__stat\"><div class=\"k\">$2.1<span class=\"unit\">M</span></div><div class=\"l\">Enterprise deals unblocked</div></div>\n    </div>\n  </div>\n</section>"
