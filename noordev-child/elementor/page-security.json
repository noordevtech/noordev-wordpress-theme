            "_column_size": 100,
            "_inline_size": null
          },
          "elements": [
            {
              "id": "nd00000c",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"controls\" data-screen-label=\"Annex A controls\">\n  <div class=\"section__head\">\n    <div>\n      <div class=\"section__eyebrow\">Annex A &middot; ISO 27001:2022</div>\n      <h2 class=\"section__title\">Four control themes, <span class=\"italic\">ninety-three</span> controls.</h2>\n    </div>\n    <p class=\"section__body\">\n      The 2022 revision consolidated 114 controls into 93 across four themes. We map each to an owner, a cadence, and a specific piece of evidence &mdash; not a paragraph of prose.\n    </p>\n  </div>\n\n  <div class=\"controls__grid\">\n    <div class=\"ctrl\">\n      <div class=\"ctrl__code\">A.5 &middot; Organizational</div>\n      <h3 class=\"ctrl__name\">Organizational controls</h3>\n      <p class=\"offer__body\" style=\"font-size: 13px; margin: 0;\">Policy, roles, supplier relationships, threat intelligence, information classification.</p>\n      <div class=\"ctrl__count\">37 controls</div>\n    </div>\n    <div class=\"ctrl\">\n      <div class=\"ctrl__code\">A.6 &middot; People</div>\n      <h3 class=\"ctrl__name\">People controls</h3>\n      <p class=\"offer__body\" style=\"font-size: 13px; margin: 0;\">Screening, terms of employment, awareness training, disciplinary process, remote work.</p>\n      <div class=\"ctrl__count\">8 controls</div>\n    </div>\n    <div class=\"ctrl\">\n      <div class=\"ctrl__code\">A.7 &middot; Physical</div>\n      <h3 class=\"ctrl__name\">Physical controls</h3>\n      <p class=\"offer__body\" style=\"font-size: 13px; margin: 0;\">Perimeters, entry, equipment, clear-desk, secure disposal, cabling and utilities.</p>\n      <div class=\"ctrl__count\">14 controls</div>\n    </div>\n    <div class=\"ctrl\">\n      <div class=\"ctrl__code\">A.8 &middot; Technological</div>\n      <h3 class=\"ctrl__name\">Technological controls</h3>\n      <p class=\"offer__body\" style=\"font-size: 13px; margin: 0;\">Access, crypto, logging, vulnerability mgmt, secure dev, backups, network security.</p>\n      <div class=\"ctrl__count\">34 controls</div>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
          "isInner": false
        }
      ],
      "isInner": false
