            "_column_size": 100,
            "_inline_size": null
          },
          "elements": [
            {
              "id": "nd00000f",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"why\" data-screen-label=\"Why Noordev\">\n  <div class=\"why__inner\">\n    <div class=\"why__left\">\n      <div class=\"section__eyebrow\">Why Noordev</div>\n      <h2 class=\"section__title\">We&rsquo;ve <span class=\"italic\">shipped</span> the thing, not just diagrammed it.</h2>\n      <p class=\"section__body\" style=\"margin-top: 24px;\">\n        Our security practice sits next to the team that ships websites and runs Odoo implementations. Our policies account for how your company actually builds and operates &mdash; not how a checklist imagines it.\n      </p>\n    </div>\n    <div class=\"why__list\">\n      <div class=\"why__item\">\n        <div class=\"why__item-num\">01 / Practitioners</div>\n        <div>\n          <h4>Operators first, auditors second</h4>\n          <p>Every lead is a practicing engineer, SRE, or sysadmin before they became a GRC consultant. Your controls will hold up to an auditor because they hold up to reality.</p>\n        </div>\n      </div>\n      <div class=\"why__item\">\n        <div class=\"why__item-num\">02 / Bilingual</div>\n        <div>\n          <h4>EN, FR, and Arabic &mdash; natively</h4>\n          <p>Policies and training materials delivered in the language your team speaks. Critical for Qu&eacute;bec (Law 25), Morocco, and multinational teams with regulated LOBs.</p>\n        </div>\n      </div>\n      <div class=\"why__item\">\n        <div class=\"why__item-num\">03 / Scoped</div>\n        <div>\n          <h4>Your ISMS, not ours</h4>\n          <p>We don&rsquo;t drop a 400-page template. We write a scope that matches your business, your risk appetite, and your audit pressure &mdash; and nothing more.</p>\n        </div>\n      </div>\n      <div class=\"why__item\">\n        <div class=\"why__item-num\">04 / Cross-framework</div>\n        <div>\n          <h4>ISO 27001 &middot; SOC 2 &middot; Law 25 &middot; PCI</h4>\n          <p>Most clients need one framework loud and two frameworks quiet. We map once and satisfy all of them &mdash; without writing three sets of policies.</p>\n        </div>\n      </div>\n      <div class=\"why__item\">\n        <div class=\"why__item-num\">05 / Beyond cert</div>\n        <div>\n          <h4>Year-one support built in</h4>\n          <p>Certification is a milestone, not a finish line. Our engagements include the first year of surveillance prep, quarterly risk reviews, and incident support.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
          "isInner": false
        }
      ],
      "isInner": false
