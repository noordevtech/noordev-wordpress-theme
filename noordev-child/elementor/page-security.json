          "elements": [
            {
              "id": "nd000003",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"hero\" data-screen-label=\"Security hero\">\n  <div class=\"hero__inner\">\n    <div class=\"hero__layout\">\n      <div>\n        <div class=\"hero__eyebrow\"><b>&bull;</b> Cybersecurity &middot; GRC &middot; ISO 27001 &middot; Risk</div>\n        <h1>\n          Security that passes audit<br>\n          and <span class=\"italic\">survives</span> reality<span class=\"dot\"></span>\n        </h1>\n        <p class=\"hero__lede\">\n          A pragmatic ISO 27001 and GRC practice for Canadian and North-African SMBs. We scope your ISMS, write the policies your team will actually follow, and walk you through certification without the theatre.\n        </p>\n        <div class=\"hero__cta\">\n          <a class=\"nd-btn nd-btn--accent nd-btn--lg\" href=\"#cta\">Book a gap assessment <span class=\"arrow\">&rarr;</span></a>\n          <a class=\"nd-btn nd-btn--ghost-light nd-btn--lg\" href=\"#iso\">See the 12-month path</a>\n          <small>Typically reply in 1 business day</small>\n        </div>\n      </div>\n\n      <div class=\"hero__card\">\n        <div class=\"hero__card-head\">\n          <div class=\"hero__card-title\">ISMS &middot; Meridian Bank &middot; Toronto</div>\n          <div class=\"hero__card-status\">Stage 2 certified</div>\n        </div>\n        <div class=\"hero__rows\">\n          <div class=\"hero__row\"><span class=\"hero__row-label\"><span class=\"bullet b-done\"></span>Gap assessment</span><span class=\"hero__row-value\">W1&ndash;2 &middot; CLOSED</span></div>\n          <div class=\"hero__row\"><span class=\"hero__row-label\"><span class=\"bullet b-done\"></span>Risk register &middot; 47 risks</span><span class=\"hero__row-value\">W3 &middot; APPROVED</span></div>\n          <div class=\"hero__row\"><span class=\"hero__row-label\"><span class=\"bullet b-done\"></span>Statement of Applicability</span><span class=\"hero__row-value\">W5 &middot; v1.2</span></div>\n          <div class=\"hero__row\"><span class=\"hero__row-label\"><span class=\"bullet b-done\"></span>93 Annex A controls</span><span class=\"hero__row-value\">W6&ndash;22 &middot; LIVE</span></div>\n          <div class=\"hero__row\"><span class=\"hero__row-label\"><span class=\"bullet b-done\"></span>Internal audit</span><span class=\"hero__row-value\">W26 &middot; 3 NC &middot; closed</span></div>\n          <div class=\"hero__row\"><span class=\"hero__row-label\"><span class=\"bullet b-done\"></span>Stage 1 &amp; 2 audit</span><span class=\"hero__row-value\">W30&ndash;34 &middot; PASS</span></div>\n          <div class=\"hero__row\"><span class=\"hero__row-label\"><span class=\"bullet b-prog\"></span>Surveillance &middot; Year 1</span><span class=\"hero__row-value\">Q2 2026 &middot; PREP</span></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
          "isInner": false
        }
      ],
      "isInner": false
