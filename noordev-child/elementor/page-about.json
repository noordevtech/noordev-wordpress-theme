              "id": "nd00000c",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"team\" aria-labelledby=\"team-title\">\n  <div class=\"section__head\">\n    <div>\n      <div class=\"section__eyebrow\">The team</div>\n      <h2 id=\"team-title\" class=\"section__title\">Senior practitioners, <span class=\"italic\">every seat</span></h2>\n    </div>\n    <p class=\"section__body\">A sample of the people you will actually meet. The full bench is twenty-eight strong across the four studios.</p>\n  </div>\n  <div class=\"team__grid\">\n    <div class=\"member\">\n      <div class=\"member__photo\" aria-hidden=\"true\" style=\"--mx: 40%; --my: 40%;\"><span class=\"member__initials\">NS<span class=\"dot\"></span></span></div>\n      <div class=\"member__name\">Noor Sadiqi</div>\n      <div class=\"member__role\">Managing partner</div>\n      <div class=\"member__loc\">Montr&eacute;al</div>\n    </div>\n    <div class=\"member\">\n      <div class=\"member__photo\" aria-hidden=\"true\" style=\"--mx: 60%; --my: 30%;\"><span class=\"member__initials\">AB<span class=\"dot\"></span></span></div>\n      <div class=\"member__name\">A&iuml;cha Bensa&iuml;d</div>\n      <div class=\"member__role\">Design director</div>\n      <div class=\"member__loc\">Toronto</div>\n    </div>\n    <div class=\"member\">\n      <div class=\"member__photo\" aria-hidden=\"true\" style=\"--mx: 30%; --my: 60%;\"><span class=\"member__initials\">JR<span class=\"dot\"></span></span></div>\n      <div class=\"member__name\">Julien Roy</div>\n      <div class=\"member__role\">Engineering lead</div>\n      <div class=\"member__loc\">Montr&eacute;al</div>\n    </div>\n    <div class=\"member\">\n      <div class=\"member__photo\" aria-hidden=\"true\" style=\"--mx: 70%; --my: 50%;\"><span class=\"member__initials\">KM<span class=\"dot\"></span></span></div>\n      <div class=\"member__name\">Karim Mansouri</div>\n      <div class=\"member__role\">Odoo partner</div>\n      <div class=\"member__loc\">Rabat</div>\n    </div>\n    <div class=\"member\">\n      <div class=\"member__photo\" aria-hidden=\"true\" style=\"--mx: 50%; --my: 20%;\"><span class=\"member__initials\">EL<span class=\"dot\"></span></span></div>\n      <div class=\"member__name\">Elena Loubet</div>\n      <div class=\"member__role\">Security lead</div>\n      <div class=\"member__loc\">Montr&eacute;al</div>\n    </div>\n    <div class=\"member\">\n      <div class=\"member__photo\" aria-hidden=\"true\" style=\"--mx: 55%; --my: 70%;\"><span class=\"member__initials\">DR<span class=\"dot\"></span></span></div>\n      <div class=\"member__name\">Diego Reyes</div>\n      <div class=\"member__role\">Growth lead</div>\n      <div class=\"member__loc\">Miami</div>\n    </div>\n    <div class=\"member\">\n      <div class=\"member__photo\" aria-hidden=\"true\" style=\"--mx: 35%; --my: 45%;\"><span class=\"member__initials\">SK<span class=\"dot\"></span></span></div>\n      <div class=\"member__name\">Sara Khalil</div>\n      <div class=\"member__role\">Brand &amp; content</div>\n      <div class=\"member__loc\">Toronto</div>\n    </div>\n    <div class=\"member\">\n      <div class=\"member__photo\" aria-hidden=\"true\" style=\"--mx: 65%; --my: 55%;\"><span class=\"member__initials\">TL<span class=\"dot\"></span></span></div>\n      <div class=\"member__name\">Th&eacute;o Lacombe</div>\n      <div class=\"member__role\">Client partner</div>\n      <div class=\"member__loc\">Montr&eacute;al</div>\n    </div>\n  </div>\n</section>"
              },
