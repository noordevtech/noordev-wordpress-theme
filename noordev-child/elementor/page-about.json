              "id": "nd000003",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"page-hero\" data-screen-label=\"About hero\">\n  <div class=\"page-hero__inner\">\n    <div>\n      <div class=\"page-hero__crumbs\">\n        <a href=\"/\">Noordev</a><span class=\"sep\">/</span><span>About</span>\n      </div>\n      <div class=\"page-hero__eyebrow\">Who we are</div>\n      <h1>\n        A senior team<br>\n        <span class=\"italic\">across four cities</span><span class=\"accent-dot\" aria-hidden=\"true\"></span>\n      </h1>\n    </div>\n    <div>\n      <p class=\"page-hero__lede\">Noordev is an independent digital practice founded in Montr&eacute;al in 2012. We work as a single senior team across Montr&eacute;al, Toronto, Miami, and Rabat &mdash; building marketing systems, Odoo platforms, and security programs for organizations that need adults in the room.</p>\n      <div class=\"page-hero__meta\">\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Founded</div><div class=\"v\">2012</div></div>\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Practitioners</div><div class=\"v\">28</div></div>\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Cities</div><div class=\"v\">4</div></div>\n      </div>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
          "isInner": false
