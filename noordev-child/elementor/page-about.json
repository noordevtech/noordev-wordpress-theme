            {
              "id": "nd000009",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"principles\" aria-labelledby=\"prin-title\">\n  <div class=\"principles__inner\">\n    <div class=\"section__head\" style=\"margin-bottom:0\">\n      <div>\n        <div class=\"section__eyebrow\">How we operate</div>\n        <h2 id=\"prin-title\" class=\"section__title\">Four principles <span class=\"italic\">we will not negotiate</span></h2>\n      </div>\n      <p class=\"section__body\">Everything else is a conversation. These four are why our clients stay.</p>\n    </div>\n    <div class=\"principles__grid\">\n      <article class=\"principle\">\n        <div class=\"principle__n\">01 &middot; Principle</div>\n        <h3 class=\"principle__title\">Senior <span class=\"italic\">always</span></h3>\n        <p class=\"principle__body\">No staff augmentation, no rotating juniors. The person on the kickoff is the person on the last call.</p>\n      </article>\n      <article class=\"principle\">\n        <div class=\"principle__n\">02 &middot; Principle</div>\n        <h3 class=\"principle__title\">Fixed scope, <span class=\"italic\">honest scope</span></h3>\n        <p class=\"principle__body\">We will tell you what is in, what is out, and what we are not sure about. Change orders are a conversation, not a surprise.</p>\n      </article>\n      <article class=\"principle\">\n        <div class=\"principle__n\">03 &middot; Principle</div>\n        <h3 class=\"principle__title\">Outcomes, <span class=\"italic\">not outputs</span></h3>\n        <p class=\"principle__body\">Every engagement carries a number we will be measured on. We will publish it monthly until it moves.</p>\n      </article>\n      <article class=\"principle\">\n        <div class=\"principle__n\">04 &middot; Principle</div>\n        <h3 class=\"principle__title\">Audit-grade <span class=\"italic\">by default</span></h3>\n        <p class=\"principle__body\">Documentation, change logs, and access controls that survive a real audit &mdash; because most of our clients eventually get one.</p>\n      </article>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
          "isInner": false
        }
      ],
      "isInner": false
    },
