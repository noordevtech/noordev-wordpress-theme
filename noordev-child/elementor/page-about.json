              "id": "nd00000f",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"locs-strip\" aria-labelledby=\"locs-title\">\n  <div class=\"locs-strip__inner\">\n    <div class=\"section__head\" style=\"margin-bottom:0\">\n      <div>\n        <div class=\"section__eyebrow\" style=\"color: var(--navy-300)\">Where to find us</div>\n        <h2 id=\"locs-title\" class=\"section__title\" style=\"color: white\">Four studios. <span class=\"italic\" style=\"color: var(--navy-200)\">One team</span></h2>\n      </div>\n      <p class=\"section__body\" style=\"color: var(--navy-300)\">Hours follow the local zone, but the team is reachable from 7am Atlantic to 7pm Pacific by design.</p>\n    </div>\n    <div class=\"locs-strip__grid\">\n      <div class=\"loc\">\n        <h3 class=\"loc__city\">Montr&eacute;al <span class=\"italic\">&middot; HQ</span></h3>\n        <p class=\"loc__addr\">475 Place d&rsquo;Armes, Suite 401, Montr&eacute;al QC H2Y 2W7</p>\n        <div class=\"loc__phone\">(450) 990-0134</div>\n      </div>\n      <div class=\"loc\">\n        <h3 class=\"loc__city\">Toronto <span class=\"italic\">&middot; Studio</span></h3>\n        <p class=\"loc__addr\">20 Bay Street, Toronto ON M5J 2N8</p>\n        <div class=\"loc__phone\">(450) 990-0134</div>\n      </div>\n      <div class=\"loc\">\n        <h3 class=\"loc__city\">Miami <span class=\"italic\">&middot; Office</span></h3>\n        <p class=\"loc__addr\">1110 Brickell Avenue, Suite 400, Miami FL 33131</p>\n        <div class=\"loc__phone\">(877) 477-4146</div>\n      </div>\n      <div class=\"loc\">\n        <h3 class=\"loc__city\">Rabat <span class=\"italic\">&middot; Office</span></h3>\n        <p class=\"loc__addr\">13 Rue Patrice Lumumba, Hassan, Rabat 10010</p>\n        <div class=\"loc__phone\">0661 86 39 92</div>\n      </div>\n    </div>\n  </div>\n</section>"
