          "elements": [
            {
              "id": "nd00000c",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"formats\" data-screen-label=\"Training formats\">\n  <div class=\"section__head\">\n    <div>\n      <div class=\"section__eyebrow\">How we deliver</div>\n      <h2 class=\"section__title\">Four formats. <span class=\"italic\">Pick</span> the one that fits your team.</h2>\n    </div>\n    <p class=\"section__body\">\n      Most clients start with one open cohort to evaluate fit, then move to private cohorts built around their instance, data, and policies.\n    </p>\n  </div>\n\n  <div class=\"formats__grid\">\n    <div class=\"format\">\n      <div class=\"format__icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><path d=\"M3 17c0-3 2-5 4-5s4 2 4 5M13 11l2 2 4-4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n      <h4>Open cohorts</h4>\n      <p>Join a mixed-company cohort. 10&ndash;18 learners, bi-weekly sessions, hands-on labs between.</p>\n      <div class=\"format__meta\"><b>Per-seat</b> &middot; Published calendar</div>\n    </div>\n    <div class=\"format\">\n      <div class=\"format__icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"4\" width=\"14\" height=\"12\" rx=\"1.5\"/><path d=\"M3 8h14\"/></svg></div>\n      <h4>Private cohorts</h4>\n      <p>We train your team on your instance, your data, your policies. Scheduled around your quarter.</p>\n      <div class=\"format__meta\"><b>Flat fee</b> &middot; Up to 20 seats</div>\n    </div>\n    <div class=\"format\">\n      <div class=\"format__icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M4 3h12v10l-3-2H4z\" stroke-linejoin=\"round\"/></svg></div>\n      <h4>Workshops</h4>\n      <p>One- or two-day intensives for exec teams, boards, or a single department. Outcome-oriented.</p>\n      <div class=\"format__meta\"><b>Day rate</b> &middot; On-site or remote</div>\n    </div>\n    <div class=\"format\">\n      <div class=\"format__icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M3 10c0-4 3-6 7-6s7 2 7 6-3 6-7 6c-1 0-2 0-3-.5L3 17l1.5-4C3 12 3 11 3 10z\" stroke-linejoin=\"round\"/></svg></div>\n      <h4>On-demand &middot; LMS</h4>\n      <p>Self-paced modules hosted in your LMS or ours. Ideal for security awareness at scale.</p>\n      <div class=\"format__meta\"><b>Per-learner</b> &middot; Annual subscription</div>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
          "isInner": false
        }
      ],
