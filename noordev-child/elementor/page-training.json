              "id": "nd000009",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"catalog\" id=\"catalog\" data-screen-label=\"Course catalog\">\n  <div class=\"catalog__inner\">\n    <div class=\"section__head\" style=\"margin-bottom: 0;\">\n      <div>\n        <div class=\"section__eyebrow\">Course catalog &middot; Fall 2026</div>\n        <h2 class=\"section__title\">Twelve courses. <span class=\"italic\">Every one</span> taught by a practitioner.</h2>\n      </div>\n      <p class=\"section__body\">\n        Most are offered as open cohorts and private client programs. Private cohorts are customized to your instance, data, and policies.\n      </p>\n    </div>\n\n    <table class=\"cat-table\">\n      <thead>\n        <tr>\n          <th>Course</th>\n          <th>Track</th>\n          <th>Duration</th>\n          <th>Language</th>\n          <th>Next cohort</th>\n          <th style=\"text-align:right;\">Price / seat</th>\n        </tr>\n      </thead>\n      <tbody>\n<tr><td class=\"cat-course\">Odoo 19 for Finance Teams<small>AR / AP &middot; multi-currency &middot; analytic accounting</small></td><td><span class=\"cat-tag odoo\">Odoo</span></td><td class=\"cat-mono\">6 wk &middot; 24 h</td><td class=\"cat-mono\">EN / FR</td><td class=\"cat-mono\">15 Sep &middot; 7 seats</td><td class=\"cat-price\">$1,850</td></tr>\n<tr><td class=\"cat-course\">Odoo 19 for Sales &amp; CRM<small>Pipelines &middot; quotes &middot; sales analytics</small></td><td><span class=\"cat-tag odoo\">Odoo</span></td><td class=\"cat-mono\">4 wk &middot; 16 h</td><td class=\"cat-mono\">EN / FR</td><td class=\"cat-mono\">22 Sep &middot; 12 seats</td><td class=\"cat-price\">$1,450</td></tr>\n<tr><td class=\"cat-course\">Odoo Inventory &amp; Manufacturing<small>Warehousing &middot; MRP &middot; BOMs &middot; routings</small></td><td><span class=\"cat-tag odoo\">Odoo</span></td><td class=\"cat-mono\">5 wk &middot; 20 h</td><td class=\"cat-mono\">EN / FR</td><td class=\"cat-mono\">06 Oct &middot; 9 seats</td><td class=\"cat-price\">$1,650</td></tr>\n<tr><td class=\"cat-course\">Odoo Admin Certification Prep<small>Configuration &middot; security &middot; technical</small></td><td><span class=\"cat-tag odoo\">Odoo</span></td><td class=\"cat-mono\">8 wk &middot; 32 h</td><td class=\"cat-mono\">EN</td><td class=\"cat-mono\">13 Oct &middot; 5 seats</td><td class=\"cat-price\">$2,850</td></tr>\n<tr><td class=\"cat-course\">Security Awareness &middot; All-Staff<small>Phishing &middot; passwords &middot; social engineering &middot; BYOD</small></td><td><span class=\"cat-tag sec\">Security</span></td><td class=\"cat-mono\">45 min + ongoing</td><td class=\"cat-mono\">EN / FR / AR</td><td class=\"cat-mono\">Rolling &middot; on-demand</td><td class=\"cat-price\">$48 / learner</td></tr>\n<tr><td class=\"cat-course\">Secure Coding for Developers<small>OWASP Top 10 &middot; SSDLC &middot; threat modeling</small></td><td><span class=\"cat-tag sec\">Security</span></td><td class=\"cat-mono\">3 wk &middot; 12 h</td><td class=\"cat-mono\">EN</td><td class=\"cat-mono\">29 Sep &middot; 14 seats</td><td class=\"cat-price\">$1,250</td></tr>\n<tr><td class=\"cat-course\">ISO 27001 Internal Auditor<small>Clauses &middot; Annex A &middot; audit planning &middot; reporting</small></td><td><span class=\"cat-tag sec\">Security</span></td><td class=\"cat-mono\">2 wk &middot; 16 h</td><td class=\"cat-mono\">EN / FR</td><td class=\"cat-mono\">20 Oct &middot; 8 seats</td><td class=\"cat-price\">$1,950</td></tr>\n<tr><td class=\"cat-course\">Finance Team Phishing &amp; Wire Fraud<small>BEC &middot; invoice fraud &middot; payment verification</small></td><td><span class=\"cat-tag sec\">Security</span></td><td class=\"cat-mono\">90 min</td><td class=\"cat-mono\">EN / FR</td><td class=\"cat-mono\">Rolling &middot; on-demand</td><td class=\"cat-price\">$240 / learner</td></tr>\n<tr><td class=\"cat-course\">SEO &amp; Content Fundamentals<small>Technical SEO &middot; keyword research &middot; editorial</small></td><td><span class=\"cat-tag growth\">Growth</span></td><td class=\"cat-mono\">4 wk &middot; 16 h</td><td class=\"cat-mono\">EN / FR</td><td class=\"cat-mono\">29 Sep &middot; 10 seats</td><td class=\"cat-price\">$1,450</td></tr>\n<tr><td class=\"cat-course\">Google Ads &amp; Meta Performance<small>Campaign structure &middot; creative &middot; measurement</small></td><td><span class=\"cat-tag growth\">Growth</span></td><td class=\"cat-mono\">3 wk &middot; 12 h</td><td class=\"cat-mono\">EN / FR</td><td class=\"cat-mono\">06 Oct &middot; 12 seats</td><td class=\"cat-price\">$1,250</td></tr>\n<tr><td class=\"cat-course\">GA4 &amp; Looker Studio<small>Event model &middot; reports &middot; attribution basics</small></td><td><span class=\"cat-tag growth\">Growth</span></td><td class=\"cat-mono\">2 wk &middot; 8 h</td><td class=\"cat-mono\">EN</td><td class=\"cat-mono\">03 Nov &middot; 15 seats</td><td class=\"cat-price\">$850</td></tr>\n<tr><td class=\"cat-course\">Digital Leadership for Execs<small>Roadmaps &middot; vendor reviews &middot; budgeting</small></td><td><span class=\"cat-tag growth\">Growth</span></td><td class=\"cat-mono\">1 day &middot; invite</td><td class=\"cat-mono\">EN / FR</td><td class=\"cat-mono\">Private only</td><td class=\"cat-price\">On request</td></tr>\n      </tbody>\n    </table>\n  </div>\n</section>"
