              "id": "nd00000f",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"outcomes\" data-screen-label=\"Training outcomes\">\n  <div class=\"outcomes__inner\">\n    <div class=\"outcomes__head\">\n      <div class=\"section__eyebrow\">What clients see</div>\n      <h2 class=\"section__title\">Training measured in <span class=\"italic\">completion</span>, not attendance.</h2>\n    </div>\n    <div class=\"outcomes__grid\">\n      <div class=\"outcome\">\n        <div class=\"k\">94<span class=\"unit\">%</span><span class=\"dot\"></span></div>\n        <div class=\"l\">Completion rate &middot; private cohorts</div>\n      </div>\n      <div class=\"outcome\">\n        <div class=\"k\">4.8<span class=\"unit\">/5</span></div>\n        <div class=\"l\">Average learner rating</div>\n      </div>\n      <div class=\"outcome\">\n        <div class=\"k\">2,400+</div>\n        <div class=\"l\">Learners trained since 2012</div>\n      </div>\n      <div class=\"outcome\">\n        <div class=\"k\">68<span class=\"unit\">%</span></div>\n        <div class=\"l\">Reduction in phishing click-through &middot; Y1</div>\n      </div>\n    </div>\n  </div>\n</section>"
