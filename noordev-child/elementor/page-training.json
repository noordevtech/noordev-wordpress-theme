              "id": "nd000003",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"hero\" data-screen-label=\"Training hero\">\n  <div class=\"hero__eyebrow\"><b>&bull;</b> Corporate training &middot; Odoo &middot; Security &middot; Digital</div>\n  <div class=\"hero__layout\">\n    <div>\n      <h1>Training your team will <span class=\"italic\">actually finish</span><span class=\"dot\"></span></h1>\n      <p class=\"hero__lede\">\n        Scenario-driven programs for Odoo, cybersecurity awareness, and digital marketing. Delivered by the same senior practitioners who run our client engagements &mdash; in English, French, or Arabic.\n      </p>\n      <div class=\"hero__cta\">\n        <a class=\"nd-btn nd-btn--accent nd-btn--lg\" href=\"#catalog\">Browse the catalog <span class=\"arrow\">&rarr;</span></a>\n        <a class=\"nd-btn nd-btn--secondary nd-btn--lg\" href=\"#cta\">Request a private cohort</a>\n        <small>Typically 10&ndash;30 learners per cohort</small>\n      </div>\n    </div>\n\n    <aside class=\"cohort\">\n      <div class=\"cohort__head\">\n        <span class=\"cohort__title\">Next open cohort</span>\n        <span class=\"cohort__live\">Enrolling</span>\n      </div>\n      <h3>Odoo 19 for Finance Teams</h3>\n      <div class=\"cohort__meta\">\n        <div class=\"cohort__row\"><span>Starts</span><b>15 September 2026</b></div>\n        <div class=\"cohort__row\"><span>Format</span><b>Hybrid &middot; 6 weeks &middot; 2&times;/wk</b></div>\n        <div class=\"cohort__row\"><span>Language</span><b>EN + FR</b></div>\n        <div class=\"cohort__row\"><span>Location</span><b>Montr&eacute;al + remote</b></div>\n        <div class=\"cohort__row\"><span>Price</span><b>$1,850 CAD / seat</b></div>\n      </div>\n      <div class=\"cohort__seats\" style=\"display:flex; align-items:baseline; gap:10px;\">\n        <span class=\"k\">7</span><span class=\"l\">of 18 seats remaining</span>\n      </div>\n      <a class=\"nd-btn nd-btn--primary\" style=\"width: 100%; justify-content: center; margin-top: 20px;\" href=\"#cta\">Reserve a seat <span class=\"arrow\">&rarr;</span></a>\n    </aside>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
          "isInner": false
        }
      ],
