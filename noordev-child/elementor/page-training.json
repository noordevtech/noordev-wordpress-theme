              "id": "nd000015",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"cta\" id=\"cta\" data-screen-label=\"Training CTA\">\n  <div class=\"cta__inner\">\n    <div>\n      <div class=\"section__eyebrow\">Let&rsquo;s talk</div>\n      <h2 class=\"cta__title\">Build a program <span class=\"italic\">for your team</span>.</h2>\n      <p class=\"cta__body\">\n        Tell us what your team needs to do next quarter &mdash; a new Odoo module, an ISO 27001 audit, a marketing capability &mdash; and we&rsquo;ll propose a cohort, a workshop, or an LMS rollout that gets them there.\n      </p>\n      <div style=\"display: flex; gap: 24px; align-items: center; font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-muted); text-transform: uppercase; letter-spacing: 0.06em;\">\n        <span>&#x2713; On-site or remote</span>\n        <span>&middot; Bilingual EN / FR</span>\n        <span>&middot; Arabic on request</span>\n      </div>\n    </div>\n\n    <form class=\"cta__form\" onsubmit=\"event.preventDefault()\">\n      <div>\n        <label>Work email</label>\n        <input type=\"email\" placeholder=\"marc@atlas.com\">\n      </div>\n      <div class=\"cta__form-row\">\n        <div>\n          <label>Company</label>\n          <input placeholder=\"Atlas Logistics\">\n        </div>\n        <div>\n          <label>Team size</label>\n          <select>\n            <option>5&ndash;15 learners</option>\n            <option>16&ndash;40 learners</option>\n            <option>40&ndash;100 learners</option>\n            <option>100+ &middot; enterprise</option>\n          </select>\n        </div>\n      </div>\n      <div>\n        <label>Track of interest</label>\n        <select>\n          <option>Odoo end-user &amp; admin</option>\n          <option>Cybersecurity awareness</option>\n          <option>ISO 27001 internal auditor</option>\n          <option>Digital marketing fundamentals</option>\n          <option>Custom / workshop</option>\n        </select>\n      </div>\n      <div class=\"submit-row\">\n        <small>&#x2713; Law 25 compliant &middot; Data stays in Canada</small>\n        <button class=\"nd-btn nd-btn--accent\">Request a cohort <span class=\"arrow\">&rarr;</span></button>\n      </div>\n    </form>\n  </div>\n</section>"
              },
