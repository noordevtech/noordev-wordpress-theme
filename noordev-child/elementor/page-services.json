            {
              "id": "nd000003",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"page-hero\" data-screen-label=\"Services hero\">\n  <div class=\"page-hero__inner\">\n    <div>\n      <div class=\"page-hero__crumbs\">\n        <a href=\"/\">Noordev</a><span class=\"sep\">/</span><span>Services</span>\n      </div>\n      <div class=\"page-hero__eyebrow\">What we do</div>\n      <h1>\n        Three disciplines.<br>\n        <span class=\"italic\">One senior team</span><span class=\"accent-dot\" aria-hidden=\"true\"></span>\n      </h1>\n    </div>\n    <div>\n      <p class=\"page-hero__lede\">\n        We build the websites that earn attention, the Odoo systems that run the business behind them, and the security posture that keeps both intact. No handoffs between agencies, no junior account managers.\n      </p>\n      <div class=\"page-hero__meta\">\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Engagements</div><div class=\"v\">140+</div></div>\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Avg. tenure</div><div class=\"v\">3.4 yrs</div></div>\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Lead time</div><div class=\"v\">6 wks</div></div>\n      </div>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
          "isInner": false
