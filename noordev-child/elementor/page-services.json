          "elements": [
            {
              "id": "nd00000f",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"engage\" aria-labelledby=\"engage-title\">\n  <div class=\"engage__inner\">\n    <div class=\"section__head\" style=\"margin-bottom:0\">\n      <div>\n        <div class=\"section__eyebrow\">How we engage</div>\n        <h2 id=\"engage-title\" class=\"section__title\">Three ways to <span class=\"italic\">work together</span></h2>\n      </div>\n      <p class=\"section__body\">Pick the shape that fits the problem. We will tell you if you have picked wrong before we send a contract.</p>\n    </div>\n\n    <div class=\"engage__grid\">\n      <article class=\"engage__card\">\n        <div class=\"engage__label\">Sprint</div>\n        <div class=\"engage__name\">Discovery sprint</div>\n        <div class=\"engage__price\">2 wks</div>\n        <p class=\"engage__body\">A scoped, fixed-cost engagement to validate the problem and shape a delivery plan we both believe in.</p>\n        <ul class=\"engage__list\">\n          <li>Stakeholder + system audit</li>\n          <li>Architecture + scope doc</li>\n          <li>Fixed delivery quote</li>\n        </ul>\n        <a href=\"/contact/\" class=\"engage__cta\">Book a sprint &rarr;</a>\n      </article>\n\n      <article class=\"engage__card engage__card--feat\">\n        <div class=\"engage__label\">Project</div>\n        <div class=\"engage__name\">Fixed-scope delivery</div>\n        <div class=\"engage__price\">6&ndash;16 wks</div>\n        <p class=\"engage__body\">A single delivery against a fixed scope and timeline, run by a senior pod of three to five.</p>\n        <ul class=\"engage__list\">\n          <li>Weekly demos &amp; change log</li>\n          <li>Fixed price, fixed dates</li>\n          <li>90-day post-launch warranty</li>\n        </ul>\n        <a href=\"/contact/\" class=\"engage__cta\">Scope a project &rarr;</a>\n      </article>\n\n      <article class=\"engage__card\">\n        <div class=\"engage__label\">Retainer</div>\n        <div class=\"engage__name\">Ongoing partnership</div>\n        <div class=\"engage__price\">Monthly</div>\n        <p class=\"engage__body\">A named team that owns the platform with you: roadmap, build, monitor, report. Quarterly business review.</p>\n        <ul class=\"engage__list\">\n          <li>Named senior pod</li>\n          <li>SLA &amp; on-call</li>\n          <li>Quarterly business review</li>\n        </ul>\n        <a href=\"/contact/\" class=\"engage__cta\">Start a retainer &rarr;</a>\n      </article>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
