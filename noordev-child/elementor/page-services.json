            {
              "id": "nd000006",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"svc-group\" aria-labelledby=\"grp-1\">\n  <header class=\"svc-group__head\">\n    <div class=\"svc-group__num\">01 / Discipline</div>\n    <h2 id=\"grp-1\" class=\"svc-group__title\">Web &amp; <span class=\"italic\">growth</span></h2>\n    <p class=\"svc-group__body\">Marketing sites, lead engines, and the SEO/paid programs that feed them. Built to ship value in weeks, not quarters.</p>\n  </header>\n  <div class=\"svc-group__cards\">\n<a class=\"svc-card\" href=\"#\">\n  <span class=\"svc-card__icon\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7h18M3 12h18M3 17h12\"/></svg></span>\n  <h3 class=\"svc-card__title\">Web design &amp; build</h3>\n  <p class=\"svc-card__body\">Marketing sites and product surfaces designed from a real brand system, built on WordPress or headless.</p>\n  <div class=\"svc-card__foot\"><span>Design + Dev</span><span class=\"svc-card__arrow\">&rarr;</span></div>\n</a>\n<a class=\"svc-card\" href=\"#\">\n  <span class=\"svc-card__icon\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg></span>\n  <h3 class=\"svc-card__title\">SEO &amp; paid media</h3>\n  <p class=\"svc-card__body\">Technical SEO, content programs, and Google/Meta paid funnels that report against revenue, not vanity.</p>\n  <div class=\"svc-card__foot\"><span>Always-on</span><span class=\"svc-card__arrow\">&rarr;</span></div>\n</a>\n<a class=\"svc-card\" href=\"#\">\n  <span class=\"svc-card__icon\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18M9 21V9\"/></svg></span>\n  <h3 class=\"svc-card__title\">WordPress engineering</h3>\n  <p class=\"svc-card__body\">Multi-site, multi-lingual, custom blocks, performance budgets, and a maintenance contract that means it.</p>\n  <div class=\"svc-card__foot\"><span>Long-term</span><span class=\"svc-card__arrow\">&rarr;</span></div>\n</a>\n<a class=\"svc-card\" href=\"#\">\n  <span class=\"svc-card__icon\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M21 12a9 9 0 1 1-9-9c2.5 0 4.8 1 6.5 2.5\"/><path d=\"M21 3v6h-6\"/></svg></span>\n  <h3 class=\"svc-card__title\">CRO &amp; analytics</h3>\n  <p class=\"svc-card__body\">GA4 + server-side events, audit-grade attribution, and a quarterly experiment pipeline against your funnel.</p>\n  <div class=\"svc-card__foot\"><span>Quarterly</span><span class=\"svc-card__arrow\">&rarr;</span></div>\n</a>\n  </div>\n</section>"
              },
              "elements": [],
