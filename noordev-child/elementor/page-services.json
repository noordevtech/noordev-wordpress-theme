          "elements": [
            {
              "id": "nd000012",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"process\" aria-labelledby=\"proc-title\">\n  <div class=\"process__inner\">\n    <div class=\"section__head\">\n      <div>\n        <div class=\"section__eyebrow\">Process</div>\n        <h2 id=\"proc-title\" class=\"section__title\">How a project <span class=\"italic\">actually runs</span></h2>\n      </div>\n      <p class=\"section__body\">Four phases. Senior-only delivery. No status meetings about status meetings.</p>\n    </div>\n    <div class=\"process__grid\">\n      <div class=\"step\"><div class=\"step__n\">01 &mdash; Discovery</div><h3 class=\"step__title\">Audit &amp; frame</h3><p class=\"step__body\">Two weeks with stakeholders, systems, and data. We leave you with a scope doc that both teams can sign.</p></div>\n      <div class=\"step\"><div class=\"step__n\">02 &mdash; Design</div><h3 class=\"step__title\">System &amp; flows</h3><p class=\"step__body\">Brand-led interface design, IA, and a tokenized design system that survives the next redesign.</p></div>\n      <div class=\"step\"><div class=\"step__n\">03 &mdash; Build</div><h3 class=\"step__title\">Ship in weeks</h3><p class=\"step__body\">Weekly demos against a public change log. You see progress the same week we make it.</p></div>\n      <div class=\"step\"><div class=\"step__n\">04 &mdash; Run</div><h3 class=\"step__title\">Operate &amp; evolve</h3><p class=\"step__body\">Quarterly business reviews, an experiment pipeline, and an SLA that means the same thing on Friday at 6pm.</p></div>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
