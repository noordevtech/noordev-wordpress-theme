              "id": "nd000003",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"page-hero\" data-screen-label=\"Case studies hero\">\n  <div class=\"page-hero__inner\">\n    <div>\n      <div class=\"page-hero__crumbs\">\n        <a href=\"/\">Noordev</a><span class=\"sep\">/</span><span>Case studies</span>\n      </div>\n      <div class=\"page-hero__eyebrow\">Selected work</div>\n      <h1>\n        Real systems.<br>\n        <span class=\"italic\">Measured outcomes</span><span class=\"accent-dot\" aria-hidden=\"true\"></span>\n      </h1>\n    </div>\n    <div>\n      <p class=\"page-hero__lede\">A representative slice of engagements across web, Odoo, and security. Numbers are reported by the client or pulled from their analytics &mdash; we will gladly share methodology on request.</p>\n      <div class=\"page-hero__meta\">\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Live cases</div><div class=\"v\">7</div></div>\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Industries</div><div class=\"v\">7</div></div>\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Avg. tenure</div><div class=\"v\">3.4 yrs</div></div>\n      </div>\n    </div>\n  </div>\n</section>"
              },
