              "id": "nd000003",
              "elType": "widget",
              "settings": {
                "html": "<section class=\"page-hero\" data-screen-label=\"Contact hero\">\n  <div class=\"page-hero__inner\">\n    <div>\n      <div class=\"page-hero__crumbs\">\n        <a href=\"/\">Noordev</a><span class=\"sep\">/</span><span>Contact</span>\n      </div>\n      <div class=\"page-hero__eyebrow\">Get in touch</div>\n      <h1>\n        Tell us about<br>\n        <span class=\"italic\">the engagement</span><span class=\"accent-dot\" aria-hidden=\"true\"></span>\n      </h1>\n    </div>\n    <div>\n      <p class=\"page-hero__lede\">A short note is enough to start. A partner reads every inbound within one business day, in any of the four time zones we operate in. Existing clients should go straight to their account channel.</p>\n      <div class=\"page-hero__meta\">\n        <div class=\"page-hero__meta-item\"><div class=\"l\">First reply</div><div class=\"v\">&lt; 1 biz day</div></div>\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Read by</div><div class=\"v\">A partner</div></div>\n        <div class=\"page-hero__meta-item\"><div class=\"l\">Time zones</div><div class=\"v\">ET &middot; PT &middot; WET</div></div>\n      </div>\n    </div>\n  </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ],
          "isInner": false
        }
      ],
      "isInner": false
    },
    {
      "id": "nd000004",
      "elType": "section",
